{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saydalety.example/schemas/pharmacy.schema.json",
  "title": "Saydalety Pharmacy Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "governorate", "address", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 2},
    "phone": {"type": ["string", "null"]},
    "governorate": {"type": "string"},
    "city_or_district": {"type": ["string", "null"]},
    "address": {"type": "string"},
    "location": {
      "type": ["object", "null"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "required": ["latitude", "longitude"],
      "additionalProperties": false
    },
    "opening_hours": {"type": ["string", "null"]},
    "services": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "string", "minLength": 5},
    "last_verified": {"type": "string", "format": "date"},
    "verification": {"enum": ["pending", "verified", "rejected"]},
    "notes": {"type": ["string", "null"]}
  }
}
